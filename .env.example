# Friday — exemplo de configuração. Copie para `.env` e ajuste conforme o ambiente.
# Todas as variáveis usam o prefixo FRIDAY_.

# --- Aplicação ---
FRIDAY_APP_NAME=Friday
FRIDAY_ENVIRONMENT=development
FRIDAY_LOG_LEVEL=INFO
FRIDAY_LOG_JSON=false

# --- Servidor (127.0.0.1 = só local; use 0.0.0.0 apenas para expor na LAN) ---
FRIDAY_HOST=127.0.0.1
FRIDAY_PORT=8000

# --- LLM (troca de modelo/provedor é SÓ configuração — Strategy Pattern) ---
FRIDAY_LLM_PROVIDER=ollama
FRIDAY_LLM_MODEL=llama3.1:8b
# Exemplos futuros: qwen3, mistral, gemma, deepseek, phi

# --- RAG (busca web + contexto) ---
FRIDAY_RAG_ENABLED=true
FRIDAY_RAG_PROVIDER=duckduckgo
FRIDAY_RAG_MAX_RESULTS=3
FRIDAY_RAG_REGION=wt-wt
FRIDAY_RAG_TIMEOUT=10.0

# --- Ollama (serviço local) ---
FRIDAY_OLLAMA_BASE_URL=http://127.0.0.1:11434
FRIDAY_OLLAMA_CONNECT_TIMEOUT=5.0
FRIDAY_OLLAMA_READ_TIMEOUT=300.0
# Pré-carrega o modelo no startup (elimina o cold start na 1ª interação):
FRIDAY_OLLAMA_WARMUP=true
